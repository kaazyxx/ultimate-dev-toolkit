      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/udt-hook.mjs\" post-git" } ] },
      { "matcher": "Edit", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/udt-hook.mjs\" post-edit" } ] },
